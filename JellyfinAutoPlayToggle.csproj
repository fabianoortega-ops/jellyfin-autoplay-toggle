<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 10.11.x exige net9.0; use net8.0 apenas para 10.9/10.10 -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>JellyfinAutoPlayToggle</AssemblyName>
    <RootNamespace>JellyfinAutoPlayToggle</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versões devem bater com a do seu servidor Jellyfin -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model"      Version="10.11.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\config.html" />
  </ItemGroup>

</Project>
